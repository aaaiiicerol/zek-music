Icon=zek-music
Categories=Audio;AudioVideo;Player;
Terminal=false
StartupWMClass=zek-music
MimeType=audio/mpeg;audio/mp3;audio/x-mp3;audio/mpeg3;audio/x-mpeg3;audio/flac;audio/x-flac;audio/ogg;audio/vorbis;audio/x-vorbis;audio/oga;audio/x-ogg;audio/wav;audio/x-wav;audio/vnd.wave;audio/mp4;audio/m4a;audio/x-m4a;audio/aac;audio/x-aac;audio/aiff;audio/x-aiff;